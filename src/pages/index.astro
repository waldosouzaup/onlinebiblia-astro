---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { getAllBooks } from '../lib/bible.js';

const books = getAllBooks();
const oldTestament = books.filter((b) => b.testament === 'old');
const newTestament = books.filter((b) => b.testament === 'new');

const siteUrl = 'https://onlinebiblia.com';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Online Bíblia',
  alternateName: ['OnlineBiblia', 'Bíblia Online'],
  url: `${siteUrl}/`,
  description: 'Leia a Bíblia Sagrada completa online com foco total na leitura, sem distrações. 66 livros e 1.189 capítulos em português e inglês.',
  inLanguage: ['pt-BR', 'en'],
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/#busca`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Online Bíblia',
  url: `${siteUrl}/`,
  logo: `${siteUrl}/favicon.svg`,
  founder: {
    '@type': 'Person',
    name: 'Waldo Eller',
  },
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Bíblia Sagrada Completa — Todos os 66 Livros',
  description: 'Navegue por todos os 66 livros da Bíblia Sagrada (NVI). Antigo e Novo Testamento com leitura suave, rápida e capítulos organizados.',
  url: `${siteUrl}/`,
  inLanguage: 'pt-BR',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: books.length,
    itemListElement: books.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.name,
      url: `${siteUrl}/biblia/${b.slug}/`,
    })),
  },
};
---

<BaseLayout
  title="Online Bíblia — Todos os 66 Livros da Bíblia Sagrada Online"
  description="Leia a Bíblia Sagrada completa online. Navegue pelos 66 livros e 1.189 capítulos do Antigo e Novo Testamento com busca rápida e leitura sem distrações."
  page="biblia"
  equivalentUrl="/en/bible/"
  schema={[websiteSchema, organizationSchema, collectionSchema]}
>
  <SiteHeader active="biblia" />

  <main class="shell bible-index-page">
    <h1 class="sr-only">Bíblia Sagrada Completa — Todos os 66 Livros do Antigo e Novo Testamento</h1>

    <!-- Destaque para o campo de busca (Spotlight Search) -->
    <header class="home-search-spotlight" id="busca">
      <div class="spotlight-search-bar">
        <span class="spotlight-search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m15.5 15.5 4.1 4.1"/></svg>
        </span>
        <input
          type="search"
          id="book-search-input"
          class="spotlight-search-input"
          placeholder="Pesquisar livro da Bíblia (ex: Salmos, Gênesis, Mateus, Sl)..."
          aria-label="Pesquisar livro da Bíblia"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="clear-search-btn"
          class="spotlight-clear-btn"
          aria-label="Limpar pesquisa"
          title="Limpar pesquisa"
          hidden
        >
          ✕
        </button>
        <span class="spotlight-counter" id="search-counter-badge">{books.length} livros</span>
      </div>

      <!-- Card de atalho rápido para capítulo quando o usuário digita passagem (ex: João 3, Salmos 23) -->
      <div id="quick-jump-card" class="quick-jump-card" hidden></div>

      <div class="filter-chips home-filter-chips" role="toolbar" aria-label="Filtro de livros por testamento">
        <button type="button" class="bible-tab-btn is-active" data-filter="all">Todos ({books.length})</button>
        <button type="button" class="bible-tab-btn" data-filter="old">Antigo Testamento ({oldTestament.length})</button>
        <button type="button" class="bible-tab-btn" data-filter="new">Novo Testamento ({newTestament.length})</button>
      </div>
    </header>

    <!-- Estado sem resultados -->
    <div id="search-no-results" class="search-no-results" hidden>
      <p>Nenhum livro encontrado para "<strong id="search-query-text"></strong>".</p>
      <button type="button" id="reset-search-btn" class="search-reset-btn">
        <span>✕ Limpar busca</span>
      </button>
    </div>

    <!-- Antigo Testamento -->
    <section class="testament-section" id="section-old" aria-labelledby="heading-old">
      <div class="section-heading">
        <div>
          <span class="testament-kicker">{oldTestament.length} LIVROS</span>
          <h2 id="heading-old">Antigo Testamento</h2>
        </div>
        <p class="section-desc">Do relato da Criação aos livros proféticos que anunciam a promessa.</p>
      </div>

      <div class="books-grid">
        {oldTestament.map((book) => (
          <article
            class="book-card"
            data-testament="old"
            data-name={book.name.toLowerCase()}
            data-group={book.group.toLowerCase()}
            data-abbrev={book.abbrev.toLowerCase()}
            data-slug={book.slug.toLowerCase()}
            data-aliases={(book.aliases || []).join(' ').toLowerCase()}
            data-chapters={book.chaptersCount}
          >
            <div class="book-card-header">
              <span class="book-order">{String(book.order).padStart(2, '0')}</span>
              <span class="book-group-tag">{book.group}</span>
            </div>
            <h3 class="book-card-title">
              <a href={`/biblia/${book.slug}/1/`}>{book.name}</a>
            </h3>
            <p class="book-card-meta">{book.chaptersCount} {book.chaptersCount === 1 ? 'capítulo' : 'capítulos'}</p>
            <div class="book-card-actions">
              <a href={`/biblia/${book.slug}/1/`} class="book-read-btn">
                Ler Cap. 1 <span aria-hidden="true">→</span>
              </a>
              <a href={`/biblia/${book.slug}/`} class="book-chapters-link" title={`Ver todos os ${book.chaptersCount} capítulos`}>
                Ver capítulos
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Novo Testamento -->
    <section class="testament-section" id="section-new" aria-labelledby="heading-new">
      <div class="section-heading">
        <div>
          <span class="testament-kicker">{newTestament.length} LIVROS</span>
          <h2 id="heading-new">Novo Testamento</h2>
        </div>
        <p class="section-desc">A vida, ensinamentos e sacrifício de Jesus, os Atos dos apóstolos, as cartas e a revelação final.</p>
      </div>

      <div class="books-grid">
        {newTestament.map((book) => (
          <article
            class="book-card"
            data-testament="new"
            data-name={book.name.toLowerCase()}
            data-group={book.group.toLowerCase()}
            data-abbrev={book.abbrev.toLowerCase()}
            data-slug={book.slug.toLowerCase()}
            data-aliases={(book.aliases || []).join(' ').toLowerCase()}
            data-chapters={book.chaptersCount}
          >
            <div class="book-card-header">
              <span class="book-order">{String(book.order).padStart(2, '0')}</span>
              <span class="book-group-tag">{book.group}</span>
            </div>
            <h3 class="book-card-title">
              <a href={`/biblia/${book.slug}/1/`}>{book.name}</a>
            </h3>
            <p class="book-card-meta">{book.chaptersCount} {book.chaptersCount === 1 ? 'capítulo' : 'capítulos'}</p>
            <div class="book-card-actions">
              <a href={`/biblia/${book.slug}/1/`} class="book-read-btn">
                Ler Cap. 1 <span aria-hidden="true">→</span>
              </a>
              <a href={`/biblia/${book.slug}/`} class="book-chapters-link" title={`Ver todos os ${book.chaptersCount} capítulos`}>
                Ver capítulos
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script>
    function setupHomeSearch() {
      const searchInput = document.getElementById('book-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      const counterBadge = document.getElementById('search-counter-badge');
      const noResultsBox = document.getElementById('search-no-results');
      const queryTextSpan = document.getElementById('search-query-text');
      const resetBtn = document.getElementById('reset-search-btn');
      const quickJumpCard = document.getElementById('quick-jump-card');
      const tabBtns = document.querySelectorAll('.bible-tab-btn');
      const bookCards = Array.from(document.querySelectorAll('.book-card'));
      const secOld = document.getElementById('section-old');
      const secNew = document.getElementById('section-new');

      if (!searchInput || bookCards.length === 0) return;

      let currentFilter = 'all';

      function normalize(str) {
        return String(str || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .trim();
      }

      function updateQuickJump(rawQuery) {
        if (!quickJumpCard) return null;

        const match = rawQuery.match(/^([0-9]?\s*[a-zA-ZÀ-ÿ]+?)\s+(\d+)(?::(\d+))?$/);
        if (!match) {
          quickJumpCard.hidden = true;
          quickJumpCard.innerHTML = '';
          return null;
        }

        const bookQuery = normalize(match[1]);
        const chapterNum = parseInt(match[2], 10);
        const verseNum = match[3] ? parseInt(match[3], 10) : null;

        // Find matching book
        const foundCard = bookCards.find((card) => {
          const name = normalize(card.getAttribute('data-name'));
          const slug = normalize(card.getAttribute('data-slug'));
          const abbrev = normalize(card.getAttribute('data-abbrev'));
          const aliases = normalize(card.getAttribute('data-aliases'));

          return (
            name === bookQuery ||
            slug === bookQuery ||
            abbrev === bookQuery ||
            name.startsWith(bookQuery) ||
            aliases.split(' ').includes(bookQuery)
          );
        });

        if (!foundCard) {
          quickJumpCard.hidden = true;
          quickJumpCard.innerHTML = '';
          return null;
        }

        const bookTitle = foundCard.querySelector('.book-card-title a')?.textContent || '';
        const bookSlug = foundCard.getAttribute('data-slug');
        const maxChapters = parseInt(foundCard.getAttribute('data-chapters') || '999', 10);

        if (chapterNum < 1 || chapterNum > maxChapters) {
          quickJumpCard.hidden = true;
          quickJumpCard.innerHTML = '';
          return null;
        }

        const targetUrl = `/biblia/${bookSlug}/${chapterNum}/`;
        const refText = verseNum ? `${bookTitle} ${chapterNum}:${verseNum}` : `${bookTitle} ${chapterNum}`;

        quickJumpCard.hidden = false;
        quickJumpCard.innerHTML = `
          <a href="${targetUrl}" class="quick-jump-link">
            <span>📖</span>
            <span>Ir direto para <strong>${refText}</strong></span>
            <span aria-hidden="true">→</span>
          </a>
          <span class="quick-jump-hint">Pressione Enter ↵</span>
        `;

        return targetUrl;
      }

      function applyFilters() {
        const rawQuery = (searchInput.value || '').trim();
        const query = normalize(rawQuery);

        if (clearBtn) {
          clearBtn.hidden = !rawQuery;
        }

        const directJumpUrl = updateQuickJump(rawQuery);

        let visibleCount = 0;
        let firstVisibleCard = null;

        bookCards.forEach((card) => {
          const testament = card.getAttribute('data-testament');
          const name = normalize(card.getAttribute('data-name'));
          const group = normalize(card.getAttribute('data-group'));
          const abbrev = normalize(card.getAttribute('data-abbrev'));
          const slug = normalize(card.getAttribute('data-slug'));
          const aliases = normalize(card.getAttribute('data-aliases'));

          const matchesTestament = currentFilter === 'all' || testament === currentFilter;
          const matchesQuery =
            !query ||
            name.includes(query) ||
            group.includes(query) ||
            abbrev === query ||
            slug.includes(query) ||
            aliases.includes(query);

          const visible = matchesTestament && matchesQuery;
          card.style.display = visible ? 'flex' : 'none';

          if (visible) {
            visibleCount++;
            if (!firstVisibleCard) firstVisibleCard = card;
          }
        });

        // Hide testament headings if all their cards are hidden
        if (secOld) {
          const hasVisibleOld = secOld.querySelectorAll('.book-card:not([style*="display: none"])').length > 0;
          secOld.style.display = hasVisibleOld ? 'block' : 'none';
        }
        if (secNew) {
          const hasVisibleNew = secNew.querySelectorAll('.book-card:not([style*="display: none"])').length > 0;
          secNew.style.display = hasVisibleNew ? 'block' : 'none';
        }

        // Update Counter
        if (counterBadge) {
          if (visibleCount === 1) {
            counterBadge.textContent = '1 livro';
          } else {
            counterBadge.textContent = `${visibleCount} livros`;
          }
        }

        // Update No results
        if (noResultsBox && queryTextSpan) {
          if (visibleCount === 0 && query) {
            queryTextSpan.textContent = rawQuery;
            noResultsBox.hidden = false;
          } else {
            noResultsBox.hidden = true;
          }
        }

        return { directJumpUrl, firstVisibleCard };
      }

      function clearSearch() {
        searchInput.value = '';
        searchInput.focus();
        applyFilters();
      }

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabBtns.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          currentFilter = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      searchInput.addEventListener('input', applyFilters);

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const { directJumpUrl, firstVisibleCard } = applyFilters();
          if (directJumpUrl) {
            window.location.href = directJumpUrl;
          } else if (firstVisibleCard) {
            const firstLink = firstVisibleCard.querySelector('.book-card-title a');
            if (firstLink) window.location.href = firstLink.href;
          }
        } else if (e.key === 'Escape') {
          clearSearch();
        }
      });

      clearBtn?.addEventListener('click', clearSearch);
      resetBtn?.addEventListener('click', clearSearch);

      // Keyboard shortcut '/' to focus search anywhere
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
          e.preventDefault();
          searchInput.focus();
          searchInput.select();
        }
      });

      // If URL has #busca, focus the search bar smoothly
      if (window.location.hash === '#busca') {
        searchInput.focus();
      }

      // Initial run
      applyFilters();
    }

    setupHomeSearch();
    document.addEventListener('astro:page-load', setupHomeSearch);
  </script>
</BaseLayout>
