---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { getAllBooks } from '../../../lib/bible.js';

const books = getAllBooks();
const oldTestament = books.filter((b) => b.testament === 'old');
const newTestament = books.filter((b) => b.testament === 'new');

const siteUrl = 'https://onlinebiblia.com';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Bible',
      item: `${siteUrl}/en/bible/`,
    },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Holy Bible (NIV) — All 66 Books',
  description: 'Read and explore all 66 books of the Holy Bible in the New International Version (NIV). Complete Old and New Testament with clean, lightweight chapters.',
  url: `${siteUrl}/en/bible/`,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: books.length,
    itemListElement: books.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.nameEn,
      url: `${siteUrl}/en/bible/${b.slugEn}/`,
    })),
  },
};
---

<BaseLayout
  title="Holy Bible (NIV) — All 66 Books | Online Bible"
  description="Read and explore all 66 books of the Holy Bible in the New International Version (NIV). Complete Old and New Testament with clean, lightweight chapters."
  page="bible-en"
  equivalentUrl="/biblia/"
  schema={[breadcrumbSchema, collectionSchema]}
>
  <SiteHeader active="bible-en" />

  <main class="shell bible-index-page">
    <h1 class="sr-only">Holy Bible (NIV) — All 66 Books of the Old and New Testament</h1>

    <!-- Prominent Spotlight Search (Matching Portuguese standard) -->
    <header class="home-search-spotlight" id="busca">
      <div class="spotlight-search-bar">
        <span class="spotlight-search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.3"/><path d="m15.5 15.5 4.1 4.1"/></svg>
        </span>
        <input
          type="search"
          id="book-search-input"
          class="spotlight-search-input"
          placeholder="Search Bible book by name, abbreviation or group (e.g. Psalms, Genesis, Matthew, Ps)..."
          aria-label="Search Bible books"
          autocomplete="off"
          spellcheck="false"
        />
        <button
          type="button"
          id="clear-search-btn"
          class="spotlight-clear-btn"
          aria-label="Clear search"
          title="Clear search"
          hidden
        >
          ✕
        </button>
        <span class="spotlight-counter" id="search-counter-badge">{books.length} books</span>
      </div>

      <!-- Quick Jump suggestion card when user types passage (e.g. John 3, Psalm 23) -->
      <div id="quick-jump-card" class="quick-jump-card" hidden></div>

      <div class="filter-chips home-filter-chips" role="toolbar" aria-label="Filter books by testament">
        <button type="button" class="bible-tab-btn is-active" data-filter="all">All ({books.length})</button>
        <button type="button" class="bible-tab-btn" data-filter="old">Old Testament ({oldTestament.length})</button>
        <button type="button" class="bible-tab-btn" data-filter="new">New Testament ({newTestament.length})</button>
      </div>
    </header>

    <!-- No results state -->
    <div id="search-no-results" class="search-no-results" hidden>
      <p>No books found for "<strong id="search-query-text"></strong>".</p>
      <button type="button" id="reset-search-btn" class="search-reset-btn">
        <span>✕ Clear search</span>
      </button>
    </div>

    <!-- Old Testament -->
    <section class="testament-section" id="section-old" aria-labelledby="heading-old">
      <div class="section-heading">
        <div>
          <span class="testament-kicker">{oldTestament.length} BOOKS</span>
          <h2 id="heading-old">Old Testament</h2>
        </div>
        <p class="section-desc">From Genesis and the account of Creation to the prophetic promises of Malachi.</p>
      </div>

      <div class="books-grid">
        {oldTestament.map((book) => (
          <article
            class="book-card"
            data-testament="old"
            data-name={book.nameEn.toLowerCase()}
            data-name-pt={book.name.toLowerCase()}
            data-group={book.groupEn.toLowerCase()}
            data-abbrev={book.abbrev.toLowerCase()}
            data-slug={book.slugEn.toLowerCase()}
            data-aliases={(book.aliases || []).join(' ').toLowerCase()}
            data-chapters={book.chaptersCount}
          >
            <div class="book-card-header">
              <span class="book-order">{String(book.order).padStart(2, '0')}</span>
              <span class="book-group-tag">{book.groupEn}</span>
            </div>
            <h3 class="book-card-title">
              <a href={`/en/bible/${book.slugEn}/1/`}>{book.nameEn}</a>
            </h3>
            <p class="book-card-meta">{book.chaptersCount} {book.chaptersCount === 1 ? 'chapter' : 'chapters'}</p>
            <div class="book-card-actions">
              <a href={`/en/bible/${book.slugEn}/1/`} class="book-read-btn">
                Read Ch. 1 <span aria-hidden="true">→</span>
              </a>
              <a href={`/en/bible/${book.slugEn}/`} class="book-chapters-link" title={`View all ${book.chaptersCount} chapters`}>
                All chapters
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- New Testament -->
    <section class="testament-section" id="section-new" aria-labelledby="heading-new">
      <div class="section-heading">
        <div>
          <span class="testament-kicker">{newTestament.length} BOOKS</span>
          <h2 id="heading-new">New Testament</h2>
        </div>
        <p class="section-desc">The life and teachings of Jesus Christ, the Acts of the Apostles, the Epistles, and Revelation.</p>
      </div>

      <div class="books-grid">
        {newTestament.map((book) => (
          <article
            class="book-card"
            data-testament="new"
            data-name={book.nameEn.toLowerCase()}
            data-name-pt={book.name.toLowerCase()}
            data-group={book.groupEn.toLowerCase()}
            data-abbrev={book.abbrev.toLowerCase()}
            data-slug={book.slugEn.toLowerCase()}
            data-aliases={(book.aliases || []).join(' ').toLowerCase()}
            data-chapters={book.chaptersCount}
          >
            <div class="book-card-header">
              <span class="book-order">{String(book.order).padStart(2, '0')}</span>
              <span class="book-group-tag">{book.groupEn}</span>
            </div>
            <h3 class="book-card-title">
              <a href={`/en/bible/${book.slugEn}/1/`}>{book.nameEn}</a>
            </h3>
            <p class="book-card-meta">{book.chaptersCount} {book.chaptersCount === 1 ? 'chapter' : 'chapters'}</p>
            <div class="book-card-actions">
              <a href={`/en/bible/${book.slugEn}/1/`} class="book-read-btn">
                Read Ch. 1 <span aria-hidden="true">→</span>
              </a>
              <a href={`/en/bible/${book.slugEn}/`} class="book-chapters-link" title={`View all ${book.chaptersCount} chapters`}>
                All chapters
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <script>
    function setupEnglishSearch() {
      const searchInput = document.getElementById('book-search-input');
      const clearBtn = document.getElementById('clear-search-btn');
      const counterBadge = document.getElementById('search-counter-badge');
      const noResultsBox = document.getElementById('search-no-results');
      const queryTextSpan = document.getElementById('search-query-text');
      const resetBtn = document.getElementById('reset-search-btn');
      const quickJumpCard = document.getElementById('quick-jump-card');
      const tabBtns = document.querySelectorAll('.bible-tab-btn');
      const bookCards = Array.from(document.querySelectorAll('.book-card'));
      const secOld = document.getElementById('section-old');
      const secNew = document.getElementById('section-new');

      if (!searchInput || bookCards.length === 0) return;

      let currentFilter = 'all';

      function normalize(str) {
        return String(str || '')
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .toLowerCase()
          .trim();
      }

      function updateQuickJump(rawQuery) {
        if (!quickJumpCard) return null;

        const match = rawQuery.match(/^([0-9]?\s*[a-zA-ZÀ-ÿ]+?)\s+(\d+)(?::(\d+))?$/);
        if (!match) {
          quickJumpCard.hidden = true;
          quickJumpCard.innerHTML = '';
          return null;
        }

        const bookQuery = normalize(match[1]);
        const chapterNum = parseInt(match[2], 10);
        const verseNum = match[3] ? parseInt(match[3], 10) : null;

        // Find matching book
        const foundCard = bookCards.find((card) => {
          const nameEn = normalize(card.getAttribute('data-name'));
          const namePt = normalize(card.getAttribute('data-name-pt'));
          const slug = normalize(card.getAttribute('data-slug'));
          const abbrev = normalize(card.getAttribute('data-abbrev'));
          const aliases = normalize(card.getAttribute('data-aliases'));

          return (
            nameEn === bookQuery ||
            namePt === bookQuery ||
            slug === bookQuery ||
            abbrev === bookQuery ||
            nameEn.startsWith(bookQuery) ||
            aliases.split(' ').includes(bookQuery)
          );
        });

        if (!foundCard) {
          quickJumpCard.hidden = true;
          quickJumpCard.innerHTML = '';
          return null;
        }

        const bookTitle = foundCard.querySelector('.book-card-title a')?.textContent || '';
        const bookSlug = foundCard.getAttribute('data-slug');
        const maxChapters = parseInt(foundCard.getAttribute('data-chapters') || '999', 10);

        if (chapterNum < 1 || chapterNum > maxChapters) {
          quickJumpCard.hidden = true;
          quickJumpCard.innerHTML = '';
          return null;
        }

        const targetUrl = `/en/bible/${bookSlug}/${chapterNum}/`;
        const refText = verseNum ? `${bookTitle} ${chapterNum}:${verseNum}` : `${bookTitle} ${chapterNum}`;

        quickJumpCard.hidden = false;
        quickJumpCard.innerHTML = `
          <a href="${targetUrl}" class="quick-jump-link">
            <span>📖</span>
            <span>Go directly to <strong>${refText}</strong></span>
            <span aria-hidden="true">→</span>
          </a>
          <span class="quick-jump-hint">Press Enter ↵</span>
        `;

        return targetUrl;
      }

      function applyFilters() {
        const rawQuery = (searchInput.value || '').trim();
        const query = normalize(rawQuery);

        if (clearBtn) {
          clearBtn.hidden = !rawQuery;
        }

        const directJumpUrl = updateQuickJump(rawQuery);

        let visibleCount = 0;
        let firstVisibleCard = null;

        bookCards.forEach((card) => {
          const testament = card.getAttribute('data-testament');
          const nameEn = normalize(card.getAttribute('data-name'));
          const namePt = normalize(card.getAttribute('data-name-pt'));
          const group = normalize(card.getAttribute('data-group'));
          const abbrev = normalize(card.getAttribute('data-abbrev'));
          const slug = normalize(card.getAttribute('data-slug'));
          const aliases = normalize(card.getAttribute('data-aliases'));

          const matchesTestament = currentFilter === 'all' || testament === currentFilter;
          const matchesQuery =
            !query ||
            nameEn.includes(query) ||
            namePt.includes(query) ||
            group.includes(query) ||
            abbrev === query ||
            slug.includes(query) ||
            aliases.includes(query);

          const visible = matchesTestament && matchesQuery;
          card.style.display = visible ? 'flex' : 'none';

          if (visible) {
            visibleCount++;
            if (!firstVisibleCard) firstVisibleCard = card;
          }
        });

        // Hide testament headings if all their cards are hidden
        if (secOld) {
          const hasVisibleOld = secOld.querySelectorAll('.book-card:not([style*="display: none"])').length > 0;
          secOld.style.display = hasVisibleOld ? 'block' : 'none';
        }
        if (secNew) {
          const hasVisibleNew = secNew.querySelectorAll('.book-card:not([style*="display: none"])').length > 0;
          secNew.style.display = hasVisibleNew ? 'block' : 'none';
        }

        // Update Counter
        if (counterBadge) {
          if (visibleCount === 1) {
            counterBadge.textContent = '1 book';
          } else {
            counterBadge.textContent = `${visibleCount} books`;
          }
        }

        // Update No results
        if (noResultsBox && queryTextSpan) {
          if (visibleCount === 0 && query) {
            queryTextSpan.textContent = rawQuery;
            noResultsBox.hidden = false;
          } else {
            noResultsBox.hidden = true;
          }
        }

        return { directJumpUrl, firstVisibleCard };
      }

      function clearSearch() {
        searchInput.value = '';
        searchInput.focus();
        applyFilters();
      }

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          tabBtns.forEach((b) => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          currentFilter = btn.getAttribute('data-filter') || 'all';
          applyFilters();
        });
      });

      searchInput.addEventListener('input', applyFilters);

      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const { directJumpUrl, firstVisibleCard } = applyFilters();
          if (directJumpUrl) {
            window.location.href = directJumpUrl;
          } else if (firstVisibleCard) {
            const firstLink = firstVisibleCard.querySelector('.book-card-title a');
            if (firstLink) window.location.href = firstLink.href;
          }
        } else if (e.key === 'Escape') {
          clearSearch();
        }
      });

      clearBtn?.addEventListener('click', clearSearch);
      resetBtn?.addEventListener('click', clearSearch);

      // Keyboard shortcut '/' to focus search anywhere
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) {
          e.preventDefault();
          searchInput.focus();
          searchInput.select();
        }
      });

      // If URL has #busca, focus the search bar smoothly
      if (window.location.hash === '#busca') {
        searchInput.focus();
      }

      // Initial run
      applyFilters();
    }

    setupEnglishSearch();
    document.addEventListener('astro:page-load', setupEnglishSearch);
  </script>
</BaseLayout>
