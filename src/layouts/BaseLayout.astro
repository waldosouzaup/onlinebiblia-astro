---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  page?: string;
  isReadingPage?: boolean;
  canonical?: string;
  lang?: string;
  equivalentUrl?: string;
  ogType?: string;
  ogImage?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title = 'Online Bíblia — Leitura Limpa da Palavra de Deus',
  description = 'Leia, pesquise e explore a Bíblia Sagrada completa com todos os 66 livros em português e inglês. Leitura suave sem distrações, rápida e acessível.',
  page = 'biblia',
  isReadingPage = false,
  canonical,
  lang = page === 'bible-en' ? 'en' : 'pt-BR',
  equivalentUrl,
  ogType = isReadingPage ? 'article' : 'website',
  ogImage,
  schema,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.origin : 'https://onlinebiblia.com';
const currentCanonical = canonical || new URL(Astro.url.pathname, siteUrl).href;
const socialImage = ogImage || new URL('/og-image.png', siteUrl).href;

// Calculate reciprocal hreflangs if equivalentUrl exists
let ptAlternate = '';
let enAlternate = '';

if (equivalentUrl) {
  if (lang === 'en') {
    enAlternate = currentCanonical;
    ptAlternate = new URL(equivalentUrl, siteUrl).href;
  } else {
    ptAlternate = currentCanonical;
    enAlternate = new URL(equivalentUrl, siteUrl).href;
  }
}
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <!-- Prevent theme flicker: default to dark -->
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('onlinebiblia-theme');
        document.documentElement.dataset.theme = savedTheme === 'light' ? 'light' : 'dark';
      } catch (_) {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>

    <!-- Basic Metadata -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={currentCanonical} />}

    <!-- Search Engine Directives -->
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
    />
    <meta
      name="googlebot"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
    />

    <!-- Multilingual Alternate Links (hreflang) -->
    {ptAlternate && <link rel="alternate" hreflang="pt-BR" href={ptAlternate} />}
    {enAlternate && <link rel="alternate" hreflang="en" href={enAlternate} />}
    {ptAlternate && <link rel="alternate" hreflang="x-default" href={ptAlternate} />}

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:site_name" content="Online Bíblia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'pt_BR'} />
    {lang === 'en' ? (
      <meta property="og:locale:alternate" content="pt_BR" />
    ) : (
      <meta property="og:locale:alternate" content="en_US" />
    )}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- PWA & Mobile Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="application-name" content="Online Bíblia" />
    <meta name="apple-mobile-web-app-title" content="Online Bíblia" />
    <meta name="theme-color" content="#0a0c0b" />
    <meta name="theme-color" content="#0a0c0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbf9f5" media="(prefers-color-scheme: light)" />

    <!-- Typography Fonts: Inter + Literata (Serif Headings) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&display=swap" rel="stylesheet" />

    <!-- Structured Data (JSON-LD) -->
    {schema && (
      Array.isArray(schema) ? (
        schema.map((item) => (
          <script type="application/ld+json" set:html={JSON.stringify(item)} />
        ))
      ) : (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      )
    )}

    <ClientRouter />
  </head>
  <body data-page={page} class:list={[{ 'is-reading-mode': isReadingPage }]}>
    <slot />
    <SiteFooter />

    <!-- Back to Top floating button -->
    <button
      id="back-to-top"
      type="button"
      class="back-to-top-btn"
      aria-label="Voltar ao topo da página"
      title="Voltar ao topo"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    </button>

    <script>
      import '../scripts/theme.js';
      import '../scripts/pwa.js';
    </script>

    <script>
      // Back-to-top button logic (compatible with Astro ClientRouter page transitions)
      function initBackToTop() {
        const btn = document.getElementById('back-to-top');
        if (!btn || btn.dataset.btBound === 'true') return;
        btn.dataset.btBound = 'true';

        let ticking = false;
        const SHOW_THRESHOLD = 320;

        function updateVisibility() {
          const scrollY = window.scrollY || document.documentElement.scrollTop;
          if (scrollY > SHOW_THRESHOLD) {
            btn.classList.add('is-visible');
          } else {
            btn.classList.remove('is-visible');
          }
          ticking = false;
        }

        window.addEventListener('scroll', () => {
          if (!ticking) {
            requestAnimationFrame(updateVisibility);
            ticking = true;
          }
        }, { passive: true });

        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Run once on init
        updateVisibility();
      }

      document.addEventListener('astro:page-load', () => {
        // Reset bound state on page transitions so it re-binds
        const btn = document.getElementById('back-to-top');
        if (btn) btn.dataset.btBound = '';
        initBackToTop();
      });

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initBackToTop();
      }
    </script>
  </body>
</html>

